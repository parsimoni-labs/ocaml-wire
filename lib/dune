(library
 (name wire)
 (public_name wire)
 (private_modules
  dsl
  lower_3d
  pp_3d
  encode_guard
  layout
  seed
  codec_leaf
  codec_repr
  codec_elem
  codec_compile
  codec_seal)
 (libraries bytesrw fmt optint))

(mdx
 (files codec.mli field.mli wire.mli)
 (libraries wire bytesrw))

; The paranoid profile checks every read [Unchecked] makes, so the tests and
; the fuzzers catch a read outside the frame (docs/execution.md). The afl
; profile does too: an AFL campaign looks for bugs rather than speed, and a read
; past the frame raises there instead of reading whatever follows.

(rule
 (target paranoid.ml)
 (enabled_if
  (or
   (= %{profile} paranoid)
   (= %{profile} afl)))
 (action
  (with-stdout-to
   %{target}
   (echo "let enabled = true\n"))))

(rule
 (target paranoid.ml)
 (enabled_if
  (and
   (<> %{profile} paranoid)
   (<> %{profile} afl)))
 (action
  (with-stdout-to
   %{target}
   (echo "let enabled = false\n"))))
