(** What a codec of fixed-size records gives its caller, whether interpreted
    ([Wire.Codec.Make]) or generated by [Wire_ocaml]: a module of type {!S} is
    swapped for another by changing one line. *)

(** A codec of records of type {!t}. *)
module type S = sig
  type t
  (** The record. *)

  val min_size : int
  (** [min_size] is the fewest bytes a record takes. *)

  val decode : bytes -> int -> (t, Errors.parse_error) result
  (** [decode buf off] is the record at [off], or the codec's error. *)

  val decode_exn : bytes -> int -> t
  (** [decode_exn] is {!decode}, raising {!Errors.Parse_error}. *)

  val encode : t -> bytes -> int -> unit
  (** [encode r buf off] writes [r] at [off]. Raises [Invalid_argument] where
      the codec does. *)

  val validate : bytes -> int -> (unit, Errors.parse_error) result
  (** [validate buf off] checks the record at [off], answering the codec's error
      as a value. *)

  val validate_exn : bytes -> int -> unit
  (** [validate_exn] is {!validate}, raising {!Errors.Parse_error}. *)

  val is_valid : bytes -> int -> bool
  (** [is_valid buf off] is [true] exactly when {!validate} accepts. *)

  (** A record checked once in a buffer named by {!Buf.v}. *)
  module View : sig
    type 'b t = private int
    (** A record that passed its check in the buffer named ['b]. *)

    type 'b check = private int
    (** The answer of a check. *)

    val at : 'b Buf.t -> 'b Buf.length -> int -> 'b t
    (** [at b len off] is the record at [off]. Raises {!Errors.Parse_error} with
        the codec's error. *)

    val check : 'b Buf.t -> 'b Buf.length -> int -> 'b check
    (** [check b len off] checks the record at [off] without raising. *)

    val ok : 'b check -> bool
    (** [ok c] is [true] when the check passed. *)

    val get : 'b check -> 'b t
    (** [get c] is the record of a check that passed. Raises [Invalid_argument]
        on one that failed. *)
  end

  (** The fields of a record, as values: a handle holds the field's reads, so
      [f.get buf off] of a known handle [f] is the field's own read, inlined
      where it is written, on OCaml's Closure as on flambda2. *)
  module Field : sig
    type 'a t = private {
      get : bytes -> int -> 'a;
          (** [f.get buf off] reads the field of the record at [off], checking
              its bounds. *)
      view : 'b. 'b Buf.t -> 'b View.t -> 'a;
          (** [f.view b v] reads the field of the record [v]. *)
    }
    (** A field holding an ['a]. *)
  end
end
