(** The errors a codec raises, and the code generated from one raises.

    [Wire] re-exports these types and {!exception-Parse_error} as its own, so a
    module generated by [Wire_ocaml] and the codec it comes from fail with the
    same exception, carrying the same value. *)

(** Which predicate a {!Constraint_failed} came from: a field's
    [~self_constraint] or [~constraint_] ([Field]), a codec's or a type's
    [~where] ([Where]), a field's [~action] ([Action]), or a [byte_array_where]
    per-byte refinement ([Per_byte]). *)
type predicate = Where | Field | Action | Per_byte

(** Parse failure categories. {!constructor-Unexpected_eof} counts bytes, not
    buffer positions: [expected] is how many the value needed and [got] how many
    were left where it starts. For {!constructor-Constraint_failed}, [value] is
    the offending field's value, and [None] for a where clause. *)
type error_kind =
  | Unexpected_eof of { expected : int; got : int }
  | Trailing_bytes of int
  | Invalid_enum of { value : int; valid : int list }
  | Invalid_tag of int
  | Missing_terminator
  | Non_zero_padding
  | Value_out_of_range of { value : int64 }
  | Zero_divisor
  | Constraint_failed of { which : predicate; value : int64 option }

type parse_error = { at : int; field : string list; kind : error_kind }
(** [at] is the absolute byte offset of the failing field, [field] the path of
    field names to it, root to leaf, empty at a top-level or anonymous position.
*)

exception Parse_error of parse_error

val pp_predicate : Format.formatter -> predicate -> unit
(** [pp_predicate] names a predicate, as in ["field constraint"]. *)

val pp_error_kind : Format.formatter -> error_kind -> unit
(** [pp_error_kind] prints a failure without its location. *)

val pp_parse_error : Format.formatter -> parse_error -> unit
(** [pp_parse_error] prints a failure with its field path and offset. *)

(** {1 Raising}

    What a fixed-size record raises, for code generated from it. Each raises
    {!exception-Parse_error}, or [Invalid_argument] where noted. *)

val negative_offset : int -> 'a
(** [negative_offset off] raises [Invalid_argument]: a record cannot start at
    the negative offset [off]. *)

val eof : at:int -> expected:int -> got:int -> 'a
(** [eof ~at ~expected ~got] raises {!Unexpected_eof} at [at]. *)

val frame : size:int -> len:int -> int -> 'a
(** [frame ~size ~len off] raises what reading a record of [size] bytes at [off]
    in a buffer of [len] bytes raises when it does not fit: {!negative_offset}
    or {!eof}. *)

val field_constraint : at:int -> field:string -> int -> 'a
(** [field_constraint ~at ~field v] raises a violated constraint of the field
    [field], whose value is [v]. *)

val invalid_enum :
  at:int -> field:string list -> value:int -> valid:int list -> 'a
(** [invalid_enum ~at ~field ~value ~valid] raises {!Invalid_enum}. *)

val invalid_tag : at:int -> field:string -> int -> 'a
(** [invalid_tag ~at ~field tag] raises {!Invalid_tag}: a lookup has no case
    [tag]. *)

val where_clause : at:int -> 'a
(** [where_clause ~at] raises a violated where clause of the record at [at]. *)

val relocate : at:int -> field:string list -> parse_error -> 'a
(** [relocate ~at ~field e] raises [e] as found at [at] in [field]: where a
    codec reports an overflow in a field's constraint or a where clause. *)

(** {1 Encoding}

    Each raises [Invalid_argument]. *)

val encode_too_short : name:string -> size:int -> len:int -> int -> 'a
(** [encode_too_short ~name ~size ~len off] raises the error for a record [name]
    of [size] bytes that does not fit at [off] in a buffer of [len] bytes. *)

val encode_rejected : name:string -> parse_error -> 'a
(** [encode_rejected ~name e] raises the error for a record [name] whose encoded
    bytes fail its own constraints with [e]. *)

val unsigned_too_wide : bits:int -> int -> 'a
(** [unsigned_too_wide ~bits v] raises the error for [v], which an unsigned
    field of [bits] bits cannot hold. *)

val byte_length : expected:int -> actual:int -> 'a
(** [byte_length ~expected ~actual] raises the error for a byte array of
    [actual] bytes where [expected] are needed. *)

val enum_encode : name:string -> valid:int list -> int -> 'a
(** [enum_encode ~name ~valid v] raises the error for [v], which is not one of
    the cases [valid] of the enum [name]. *)
