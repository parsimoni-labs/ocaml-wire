(** What a scanner gives its caller, whether interpreted ([Wire.Codec.Scan]) or
    generated by [Wire_ocaml.scanner ~step]: a module of type {!S} is swapped
    for another by changing one line.

    A scanner checks a record in a frame of bytes and hands its outputs, the
    named scalar fields of the record, to a consumer whose accumulator has type
    {!S.step}. The consumer is fixed when the scanner is made: the generated one
    calls it by name, so the compiler inlines it, and the interpreted one takes
    it as a functor argument. *)

(** A scanner whose consumer folds an accumulator of type {!step}. *)
module type S = sig
  type step
  (** The type for the consumer's accumulator. *)

  val fold_step : bytes -> int -> int -> init:step -> step
  (** [fold_step buf off len ~init] is the consumer's [valid init] applied to
      the outputs of the record at [off] in the [len] bytes there, or its
      [invalid init] when the record or the bounds are bad. *)

  val fold_frames_step : bytes -> int -> int -> stride:int -> init:step -> step
  (** [fold_frames_step buf off len ~stride ~init] folds {!fold_step} over the
      [len / stride] frames of [stride] bytes at [off], in order, from [init].
      Raises [Invalid_argument] if [stride] is not positive or the bounds are
      bad. *)

  val fold_index_step :
    bytes -> offs:int array -> lens:int array -> init:step -> step
  (** [fold_index_step buf ~offs ~lens ~init] folds {!fold_step} over the frames
      of [lens.(i)] bytes at [offs.(i)], in order, from [init]. Raises
      [Invalid_argument] if [offs] and [lens] differ in length. *)
end
