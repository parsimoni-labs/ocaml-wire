; The paranoid profile checks every read [Unchecked] makes, so the tests and
; the fuzzers catch a read outside the frame (docs/execution.md). The afl
; profile does too: an AFL campaign looks for bugs rather than speed, and a read
; past the frame raises there instead of reading whatever follows.

(rule
 (target paranoid.ml)
 (enabled_if
  (or
   (= %{profile} paranoid)
   (= %{profile} afl)))
 (action
  (with-stdout-to
   %{target}
   (echo "let enabled = true\n"))))

(rule
 (target paranoid.ml)
 (enabled_if
  (and
   (<> %{profile} paranoid)
   (<> %{profile} afl)))
 (action
  (with-stdout-to
   %{target}
   (echo "let enabled = false\n"))))

; [Vec] holds the NEON operations of the code Wire_ocaml generates with
; [~simd:true]. They are OxCaml builtins on arm64 and exist nowhere else, so
; the module is empty on other compilers and architectures.

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (= %{architecture} arm64)))
 (action
  (progn
   (copy vec.neon.ml vec.ml)
   (copy vec.neon.mli vec.mli)
   (copy vec_stubs.neon.c vec_stubs.c))))

(rule
 (enabled_if
  (or
   (<> %{ocaml-config:ox} true)
   (<> %{architecture} arm64)))
 (action
  (progn
   (copy vec.none.ml vec.ml)
   (copy vec.none.mli vec.mli)
   (copy vec_stubs.none.c vec_stubs.c))))
