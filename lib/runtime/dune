; What the code Wire_ocaml generates links instead of [wire]: the integer
; carriers, the reads and writes with no bounds check, and the parse errors.
; [wire] is built on it, so a generated module and a codec share one type for
; each and raise the very same exceptions. OxCaml additionally uses its bundled
; unboxed integer library; ordinary OCaml needs only optint, so embedding
; generated code pulls in nothing else.

(library
 (name wire_runtime)
 (public_name wire.runtime)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (private_modules loads prims carrier)
 (modules_without_implementation record)
 ; On OxCaml every value of these modules is [portable]: they hold no state
 ; and only compute, read the buffer they are given or raise, so any domain
 ; may call them. Only OxCaml syntax can say so, so on OxCaml their shared
 ; interface is read under that modality. The library is declared once per
 ; compiler so that no other compiler preprocesses it: there each unit is
 ; compiled from its own source.
 (preprocess
  (per_module
   ((action
     (system
      "case %{input-file} in *.mli) printf '@@ portable ';; esac; cat %{input-file}"))
    unchecked
    errors
    arith
    uInt8
    uInt16
    sInt8
    sInt16
    uInt32
    sInt32)))
 (foreign_stubs
  (language c)
  (names vec_stubs))
 (libraries
  optint
  (select
   loads.ml
   from
   (stdlib_upstream_compatible -> loads.ox.ml)
   (-> loads.std.ml))
  (select
   loads.mli
   from
   (stdlib_upstream_compatible -> loads.ox.mli)
   (-> loads.std.mli))
  (select
   carrier.ml
   from
   (stdlib_upstream_compatible -> carrier.ox.ml)
   (-> carrier.std.ml))
  (select
   carrier.mli
   from
   (stdlib_upstream_compatible -> carrier.ox.mli)
   (-> carrier.std.mli))
  (select
   prims.ml
   from
   (stdlib_upstream_compatible -> prims.ox.ml)
   (-> prims.std.ml))
  (select
   prims.mli
   from
   (stdlib_upstream_compatible -> prims.ox.mli)
   (-> prims.std.mli))
  (select
   buf.ml
   from
   (stdlib_upstream_compatible -> buf.ox.ml)
   (-> buf.std.ml))
  (select
   buf.mli
   from
   (stdlib_upstream_compatible -> buf.ox.mli)
   (-> buf.std.mli))))

(library
 (name wire_runtime)
 (public_name wire.runtime)
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (private_modules loads prims carrier)
 (modules_without_implementation record)
 (foreign_stubs
  (language c)
  (names vec_stubs))
