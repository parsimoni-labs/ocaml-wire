; -- Shared benchmark framework --

(library
 (name bench_lib)
 (modules bench_lib ox)
 (libraries unix fmt))

; The flags the [bench] profile of dune-workspace adds to every unit, for the
; compiler that builds: what bench/flags-sweep.sh picks for OCaml, OCaml with
; flambda and OxCaml (bench/README.md, Compiler flags).

(rule
 (enabled_if
  (and
   (<> %{ocaml-config:ox} true)
   (= %{ocaml-config:flambda} false)))
 (action
  (with-stdout-to
   flags.sexp
   (echo "(-inline 50)\n"))))

(rule
 (enabled_if
  (= %{ocaml-config:flambda} true))
 (action
  (with-stdout-to
   flags.sexp
   (echo "(-O2)\n"))))

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   flags.sexp
   (echo "(-O4)\n"))))

; [Ox.v] tells the rows measured in their own process which compiler built
; them, and [Ox.flambda] whether an OCaml compiler has flambda.

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   ox.ml
   (echo "let v = true\nlet flambda = false\n"))))

(rule
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   ox.ml
   (echo "let v = false\nlet flambda = %{ocaml-config:flambda}\n"))))

; -- EverParse benchmark infrastructure --

; Generator -- pure OCaml, always builds

(executable
 (name gen_stubs)
 (modules gen_stubs)
 (libraries demo_bench_cases demo space net wire wire.3d wire.stubs fmt unix))

; Generate c_stubs.ml (OCaml external declarations) -- always

(rule
 (target c_stubs.ml)
 (deps gen_stubs.exe)
 (action
  (with-stdout-to
   %{target}
   (run ./gen_stubs.exe --ml-only))))

; Generate .3d files, run EverParse, produce C code -- gated

; [gen_stubs.exe] also archives the per-codec validators into [libbenchcodecs.a]
; (via [Wire_stubs.build_codec_archive]) so [c_stubs.c] and the per-bench app C,
; which include only the headers, link against them as separate translation
; units. Compiling each codec separately, rather than [#include]-ing the [.c]
; into one unit, keeps the per-codec shared types translation-unit-local.

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (targets
  (dir schemas)
  c_stubs.c
  libbenchcodecs.a)
 (deps gen_stubs.exe)
 (action
  (run ./gen_stubs.exe schemas)))

; OCaml stubs library -- always builds (externals resolved at link time)

(library
 (name c_stubs)
 (modules c_stubs))

; C foreign stubs -- gated (provides the C implementations for c_stubs externals)

(library
 (name c_stubs_c)
 (modules)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (foreign_archives benchcodecs)
 (foreign_stubs
  (language c)
  (names c_stubs)
  (extra_deps
   (glob_files schemas/*.h))
  (flags :standard -I schemas -I ../lib/stubs)))
