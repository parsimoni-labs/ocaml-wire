(library
 (name hw_bench)
 (modules hw_bench)
 (enabled_if
  (= %{env:BUILD_HARDCAML=} "1"))
 (libraries net wire wire.ocaml wire_hardcaml hardcaml))

(executable
 (name gen)
 (modules gen padding properties validation_miter)
 (enabled_if
  (= %{env:BUILD_HARDCAML=} "1"))
 (libraries hw_bench hardcaml net wire wire.ocaml wire_hardcaml))

; The checksum contribution of one frame the hardware is compared with: the
; fold of g_selected, the module of Packet_stack.codec whose fold hands out the
; fields the checksum reads, as bench/rust computes it.

(rule
 (enabled_if
  (= %{env:BUILD_HARDCAML=} "1"))
 (targets g_selected.ml g_selected.mli)
 (action
  (run %{dep:../rust/gen.exe} %{targets})))

(rule
 (enabled_if
  (= %{env:BUILD_HARDCAML=} "1"))
 (action
  (copy ../rust/selected_read.ml selected_read.ml)))

(executable
 (name test)
 (modules test g_selected selected_read)
 (enabled_if
  (= %{env:BUILD_HARDCAML=} "1"))
 (libraries
  hw_bench
  hardcaml
  wire
  wire.runtime
  bytesrw
  net
  hardware_test_io
  fmt))
