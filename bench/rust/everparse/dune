; The EverParse C rows of the packet-stack benchmark: the verified validator of
; Packet_stack.codec in a C loop, reading the fields through the default
; EthernetStack_Fields visitor (stack_c.c, linked against the validators
; bench/gen_stubs.exe archives, as the application benchmarks are), and
; through a custom visitor compiled with the validator's C (stack_inline.c).
; Built only with EverParse (BUILD_EVERPARSE=1).

(library
 (name stack_everparse_c)
 (modules)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (libraries c_stubs_c)
 (foreign_stubs
  (language c)
  (names stack_c stack_inline)
  (extra_deps
   stack_fold.h
   (glob_files ../../schemas/*.h)
   ../../schemas/EthernetStack.c)
  ; A setter of stack_inline.c the validator does not call leaves the call to
  ; the shipped visitor, which writes past the custom WIRECTX.
  (flags :standard -Werror=unused-function -I ../.. -I ../../schemas)))

(executable
 (name everparse)
 (modules everparse)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (libraries stack_everparse_c fmt))
