; Cross-language benchmark: Ethernet/IPv4/TCP-or-UDP header parsing through
; Wire.Codec and the OCaml Wire_ocaml generates (this directory: for the OCaml
; target on OCaml, for the OxCaml target on an OxCaml compiler), and through
; the Rust Wire_rust generates against etherparse and smoltcp (cargo/, a cargo
; project outside the dune build so that dune never needs the network).
; `make bench-rust` runs both and prints one table.

(library
 (name headers)
 (modules headers)
 (libraries wire))

(executable
 (name gen)
 (modules gen)
 (libraries headers wire.ocaml wire.rust))

(rule
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (targets g_eth.ml g_ipv4.ml g_tcp.ml g_udp.ml)
 (action
  (run ./gen.exe --ocaml)))

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (targets g_eth.ml g_ipv4.ml g_tcp.ml g_udp.ml)
 (action
  (run ./gen.exe --oxcaml)))

; The OxCaml code carries [@zero_alloc] checks, which cannot pass in the dev
; profile (see test/ocaml-ox/dune); the benchmark builds in release.

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (= %{profile} dev)))
 (action
  (with-stdout-to
   zero_alloc.sexp
   (echo "(-zero-alloc-check none)"))))

(rule
 (enabled_if
  (or
   (<> %{ocaml-config:ox} true)
   (<> %{profile} dev)))
 (action
  (with-stdout-to
   zero_alloc.sexp
   (echo "()"))))

(executable
 (name bench)
 (modules bench g_eth g_ipv4 g_tcp g_udp)
 (ocamlopt_flags
  (:standard
   (:include zero_alloc.sexp)))
 (libraries headers wire wire.runtime unix fmt))
