 (wrapped false)
 (libraries schemas wire wire.runtime bytesrw))

; On OxCaml the modules take their buffers [local], and a function of a
; [local] buffer and an offset is no function of a global one: the
; signatures, which a stock compiler reads, hold for the OCaml target.

(test
 (name test_signature)
 (modules test_signature)
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (libraries generated clcw stack wire wire.ocaml))

(test
 (name test)
 (modules
  test
  test_wire_ocaml
  test_view_module
  test_writer
  test_value_module
  test_scan
  boxed_loads)
 (libraries
  generated
  schemas
  wire
  wire.runtime
  wire.ocaml
  net
  bytesrw
  fmt
  alcotest))

