; Whether a 64-bit load of wire.runtime returns a boxed int64 to the code
; generated for OCaml: in the dev profile, which compiles wire.runtime with
; -opaque, the call is not inlined.

(rule
 (target boxed_loads.ml)
 (enabled_if
  (= %{profile} dev))
 (action
  (write-file %{target} "let v = true\n")))

(rule
 (target boxed_loads.ml)
 (enabled_if
  (<> %{profile} dev))
 (action
  (write-file %{target} "let v = false\n")))

