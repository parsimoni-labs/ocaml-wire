(rule
 (targets checked_step.ml)
 (action
  (run ./gen.exe --step %{targets})))

(rule
 (targets g_checked.ml g_checked.mli g_checked_codec.ml g_checked_codec.mli)
 (action
  (run ./gen.exe %{targets} --visitor fold=%{dep:checked_step.ml})))

