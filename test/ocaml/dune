; One rule per module under test, as Wire_ocaml.main reads its command line;
; each fixed record of named scalars but under a map comes with its twin.

(rule
 (targets g_ipv4.ml g_ipv4.mli g_ipv4_codec.ml g_ipv4_codec.mli)
 (action
  (run ./gen.exe %{targets})))

(rule
 (targets
  g_ipv4_record.ml
  g_ipv4_record.mli
  g_ipv4_record_codec.ml
  g_ipv4_record_codec.mli)
 (action
  (run ./gen.exe %{targets})))

