(rule
 (targets
  s_capture_step.ml
  s_capture_step.mli
  s_capture_step_codec.ml
  s_capture_step_codec.mli)
 (action
  (run
   %{dep:gen_scan.exe}
   %{targets}
   --visitor
   fold_step=%{dep:scan_step.ml})))

