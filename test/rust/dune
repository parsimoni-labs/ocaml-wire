(executable
 (name gen)
 (modules gen)
 (libraries schemas wire.rust fmt))

(test
 (name test)
 (modules test test_wire_rust)
 (libraries schemas wire wire.rust fmt alcotest))

; The modules generated from the schemas compile as one no_std crate, with
; every warning an error. Needs rustc, so it runs with BUILD_RUST=1, as the
; Rust lane of the differential fuzzer does.

(rule
 (alias runtest)
 (enabled_if
  (= %{env:BUILD_RUST=} "1"))
 (action
  (progn
   (run ./gen.exe rs)
   (run
    rustc
    --edition
    2021
    --crate-type
    rlib
    -O
    -D
    warnings
    -o
    rs/libschemas.rlib
    rs/lib.rs))))
