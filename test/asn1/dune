(library
 (name asn1_modules)
 (modules asn1_modules)
 (libraries wire rfc5280))

(test
 (name test)
 (modules test)
 (libraries wire asn1_modules alcotest fmt re))

(executable
 (name verify)
 (modules verify)
 (libraries wire.3d wire.asn1 asn1_modules))

; With BUILD_EVERPARSE=1, everparse-asn1 checks every module of Asn1_modules
; in full (make asn1): F* verifies the two modules it generates for each, each
; run says so ("All verification conditions discharged", which
; Wire_asn1.run_everparse requires), and the C it extracts compiles with the
; flags EverParse's own tests use. everparse-asn1.exe is found in PATH or
; ~/.local/everparse/bin, and finds F*, Z3 and its libraries under
; EVERPARSE_HOME, by default the prefix it is installed in.

(rule
 (alias runtest)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  verify.exe
  (env_var PATH)
  (env_var EVERPARSE_HOME)
  (env_var WIRE_3D_JOBS))
 (action
  (bash
   "rm -rf out && mkdir out; ./verify.exe out > verify.log 2>&1; rc=$?; for f in out/*.asn; do m=$(basename \"$f\" .asn); tail -n 1 \"out/$m.log\" 2>/dev/null || echo \"$m: not run\"; done; [ $rc -eq 0 ] || { cat verify.log; exit 1; }; for f in out/*.asn; do m=$(basename \"$f\" .asn); grep -qE \"^$m: verified in [0-9]+s$\" \"out/$m.log\" || exit 1; done; n=0; for c in out/*.c; do cc -std=c11 -Wall -Wextra -Werror -Wno-type-limits -Wno-unused-variable -O1 -c -I out \"$c\" -o \"${c%.c}.o\" || exit 1; echo \"$(basename \"$c\"): compiled\"; n=$((n + 1)); done; m=$(ls out/*.asn | wc -l); [ \"$n\" -eq \"$m\" ] || { echo \"$n C files for $m modules\"; exit 1; }")))
