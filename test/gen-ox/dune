; The generator's tests again, on the code it writes for OxCaml. The modules
; are a library so the compiler checks each [@zero_alloc] they carry. Any
; compiler generates them; only an OxCaml compiler builds and runs them.

(copy_files
 (files ../gen/{test,test_wire_gen}.{ml,mli}))

(rule
 (targets
  g_ipv4.ml
  g_ipv4_record.ml
  g_checked.ml
  g_mixed.ml
  g_small.ml
  g_eth.ml
  g_wide.ml
  g_mapped.ml)
 (action
  (run ../gen/gen.exe --oxcaml)))

(library
 (name gens_ox)
 (enabled_if
  (= %{ocaml_version} 5.4.0+ox))
 (wrapped false)
 (modules
  g_ipv4
  g_ipv4_record
  g_checked
  g_mixed
  g_small
  g_eth
  g_wide
  g_mapped)
 (libraries schemas wire))

(executable
 (name test)
 (enabled_if
  (= %{ocaml_version} 5.4.0+ox))
 (modules test test_wire_gen)
 (libraries gens_ox schemas wire wire.gen fmt alcotest))

(rule
 (alias runtest)
 (enabled_if
  (= %{ocaml_version} 5.4.0+ox))
 (action
  (run ./test.exe)))
