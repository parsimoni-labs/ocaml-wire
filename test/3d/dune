(executable
 (name gen_3d)
 (modules gen_3d)
 (libraries wire demo space net))

(test
 (name test)
 (modules
  test
  agree
  gate
  test_wire_3d
  test_wire_3d_corpus
  test_wire_3d_proc
  test_wire_3d_shapes
  test_wire_3d_arith)
 (deps
  (env_var BUILD_EVERPARSE))
 (libraries wire wire.3d asn1_modules alcotest re unix threads.posix fmt))

(rule
 (targets
  Bitfields.3d
  Enumerations.3d
  FieldDependence.3d
  Minimal.3d
  AllInts.3d
  Bitfield8.3d
  Bitfield16.3d
  Bitfield32.3d
