  Net.3d
  Space.3d
  Demo.3d)
 (deps gen_3d.exe)
 (action
  (run ./gen_3d.exe)))

; EverParse 3D validation

(rule
 (alias 3d)
 (deps
  Bitfields.3d
  Enumerations.3d
  FieldDependence.3d
  Net.3d
  Space.3d
  Demo.3d)
 (action
  (bash
   "e=~/.local/everparse/bin/everparse-3d.exe; [ -x \"$e\" ] || e=~/.local/everparse/bin/3d.exe; \"$e\" --version && for f in *.3d; do \"$e\" --batch \"$f\" > /dev/null 2>&1 || exit 1; done")))
