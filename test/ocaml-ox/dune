  (= %{ocaml-config:ox} true))
 (targets s_nested.ml s_nested.mli)
 (action
  (run %{dep:../ocaml/gen.exe} %{targets})))

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (or
    (= %{architecture} arm64)
    (= %{architecture} amd64))))
 (targets g_lanes.ml g_lanes.mli)
 (action
  (setenv
   WIRE_SIMD
   1
   (run %{dep:../ocaml/gen.exe} %{targets}))))

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (<> %{architecture} arm64)
   (<> %{architecture} amd64)))
 (targets g_lanes.ml g_lanes.mli)
 (action
  (run %{dep:../ocaml/gen.exe} %{targets})))

; Whether a 64-bit load of wire.runtime returns a boxed int64 to the code
; generated: on OxCaml a load gives an int64_u in any profile.

(rule
 (target boxed_loads.ml)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (write-file %{target} "let v = false\n")))

(library
 (name gens_ox)
 (wrapped false)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (modules
  test_wire_ocaml
  test_view_module
  test_writer
  test_value_module
  test_scan
  g_ipv4
  g_ipv4_record
  g_mixed_record
  g_checked
  g_mixed
  g_small
  g_eth
  g_wide
  g_signed
  g_packed
  g_refined
  g_overflow
  g_mapped
  s_sized
  s_overflow
  s_skipped
  s_capture
  s_capture_step
  s_huge
  s_nested
  g_lanes
  boxed_loads)
 (libraries schemas wire wire.runtime wire.ocaml net bytesrw fmt alcotest))

; The signatures of Wire_ocaml with the buffers the OxCaml target takes
; [local] (test_signature.ox.ml, OxCaml syntax), which every module above is
; ascribed to: a library, so that only an OxCaml compiler builds it.

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (copy test_signature.ox.ml test_signature.ml)))

(library
 (name signature_ox)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (modules test_signature)
 (libraries gens_ox wire wire.ocaml))

(executable
 (name test)
 (modules test)
 (libraries
  fmt
  (select
   test.ml
   from
   (gens_ox alcotest -> test.ox.ml)
   (-> test.std.ml))))

(rule
 (alias runtest)
 (action
  (run ./test.exe)))

; The modes of the code for OxCaml: buffers on the stack, local constructors
; and portable callers. test_modes.ox.ml is OxCaml syntax over its unboxed
; integer library, so only an OxCaml compiler with that library builds it.

(rule
 (with-stdout-to
  test_modes.std.ml
  (echo "let suite = (\"modes\", [])\n")))

(executable
 (name test_modes_main)
 (modules test_modes_main test_modes)
 (libraries
  alcotest
  (select
   test_modes.ml
   from
   (gens_ox stdlib_upstream_compatible wire.runtime -> test_modes.ox.ml)
   (-> test_modes.std.ml))))

(rule
 (alias runtest)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (run ./test_modes_main.exe)))

; The SIMD lanes of the code for OxCaml on arm64 and amd64 ([--simd]) against
; one record at a time. test_simd.ml.ox is OxCaml syntax over NEON or SSE
; builtins, so only an OxCaml compiler for those builds it; any other runs an
; empty suite.

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (or
    (= %{architecture} arm64)
    (= %{architecture} amd64))))
 (action
  (copy test_simd.ml.ox test_simd.ox.ml)))

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (<> %{architecture} arm64)
   (<> %{architecture} amd64)))
 (action
  (copy test_simd.std.ml test_simd.ox.ml)))

(rule
 (with-stdout-to
  test_simd.std.ml
  (echo
   "module _ = Wire_runtime.Vec (* empty here *)\nlet suite = (Fmt.str \"simd\", [])\n")))

(executable
 (name test_simd_main)
 (modules test_simd_main test_simd)
 (libraries
  wire.runtime
  fmt
  alcotest
  (select
   test_simd.ml
   from
   (gens_ox -> test_simd.ox.ml)
   (-> test_simd.std.ml))))

(rule
 (alias runtest)
 (action
  (run ./test_simd_main.exe)))
