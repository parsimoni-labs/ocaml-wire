; The generator's tests again, on the code it writes for OxCaml. The modules
; are a library so the compiler checks each [@zero_alloc] they carry. Only an
; OxCaml compiler builds it: on any other, each executable selects a stub, as
; an executable's enabled_if cannot read %{ocaml-config:ox}, and test.exe says
; the tests were skipped rather than repeat test/ocaml.

(copy_files
 (files ../ocaml/test_wire_ocaml.{ml,mli}))

(copy_files
 (files ../ocaml/test_view_module.{ml,mli}))

(copy_files
 (files ../ocaml/test_scan.{ml,mli}))

(copy_files
 (files ../ocaml/test_writer.{ml,mli}))

(copy_files
 (files ../ocaml/test_value_module.{ml,mli}))

(rule
 (copy ../ocaml/test.ml test.ox.ml))

(rule
 (with-stdout-to
  test.std.ml
  (echo
   "let () = Fmt.pr \"test/ocaml-ox: skipped, OCaml %s is not an OxCaml compiler@.\" Sys.ocaml_version\n")))

; One rule per module under test, as in ../ocaml; on arm64 and amd64 the
; records of g_lanes get SIMD lanes (WIRE_SIMD=1).

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (targets g_ipv4.ml g_ipv4.mli)
 (action
  (run %{dep:../ocaml/gen.exe} %{targets})))

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (targets g_ipv4_record.ml g_ipv4_record.mli)
 (action
  (run %{dep:../ocaml/gen.exe} %{targets})))

