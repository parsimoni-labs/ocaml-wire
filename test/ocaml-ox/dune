(executable
 (name test)
 (modules test)
 (libraries gens_ox alcotest))

(rule
 (alias runtest)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (run ./test.exe)))

(rule
 (alias runtest)
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (action
  (echo
   "test/ocaml-ox: skipped, OCaml %{ocaml_version} is not an OxCaml compiler\n")))

; The modes of the code for OxCaml: buffers on the stack, local constructors
; and portable callers. test_modes.ox.ml is OxCaml syntax, so only an OxCaml
; compiler, which has its unboxed integer library, builds it; any other runs
; an empty suite.

(rule
 (with-stdout-to
  test_modes.std.ml
  (echo "let suite = (\"modes\", [])\n")))

(executable
 (name test_modes_main)
 (modules test_modes_main test_modes)
 (libraries
  gens_ox
  alcotest
  (select
   test_modes.ml
   from
   (stdlib_upstream_compatible wire.runtime -> test_modes.ox.ml)
   (-> test_modes.std.ml))))

(rule
 (alias runtest)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (run ./test_modes_main.exe)))

; The SIMD lanes of the code for OxCaml on arm64 and amd64 ([--simd]) against
; one record at a time. test_simd.ml.ox is OxCaml syntax over NEON or SSE
; builtins, so only an OxCaml compiler for those builds it; any other runs an
; empty suite.

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (or
    (= %{architecture} arm64)
    (= %{architecture} amd64))))
 (action
  (copy test_simd.ml.ox test_simd.ml)))

(rule
 (enabled_if
  (or
   (<> %{ocaml-config:ox} true)
   (and
    (<> %{architecture} arm64)
    (<> %{architecture} amd64))))
 (action
  (with-stdout-to
   test_simd.ml
   (echo
    "module _ = Wire_runtime.Vec (* empty here *)\nlet suite = (Fmt.str \"simd\", [])\n"))))

(executable
 (name test_simd_main)
 (modules test_simd_main test_simd)
 (libraries gens_ox wire.runtime fmt alcotest))

(rule
 (alias runtest)
 (action
  (run ./test_simd_main.exe)))
