; Whether the fold of s_nested boxes the int64 values it hands its visitor:
; in the dev profile, which compiles this library -opaque, the visitor
; nested_step.ml is a unit of its own the fold calls rather than inlines. A
; load of wire.runtime gives an int64_u on OxCaml in any profile.

(rule
 (target boxed_loads.ml)
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (= %{profile} dev)))
 (action
  (write-file %{target} "let v = true\n")))

(rule
 (target boxed_loads.ml)
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (<> %{profile} dev)))
 (action
  (write-file %{target} "let v = false\n")))

