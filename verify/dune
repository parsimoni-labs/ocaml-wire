; Translation validation of the code Wire_ocaml generates: main.exe reads a
; generated module, executes it symbolically to bit-vector formulas, and has
; Z3 prove its reads in bounds and its answers equal to those of the EverParse
; 3D specification of the same codec (main.ml says what each check states).
; It needs EverParse (3d.exe, for the specification's SMT encoding) and z3,
; so it runs only with BUILD_EVERPARSE=1, as the other EverParse lanes do.

(executable
 (name gen)
 (modules gen)
 (libraries wire wire.ocaml space net demo))

(executable
 (name main)
 (modules main check linear spec symex smt z3)
 (libraries compiler-libs.common fmt unix))

(rule
 (targets
  Clcw.3d
  Stack.3d
  BfConstrained.3d
  ReservedFields.3d
  stack_ox.gen
  stack_step.gen
  stack_step_ox.gen
  bf_constrained.gen
  reserved_fields.gen)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (run ./gen.exe .)))

; The record modules: is_valid, View.check and the accessors behind it, each
; window of up to 16 bytes compared with the specification.

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps
  %{project_root}/examples/generated/clcw.ml
  Clcw.3d
  BfConstrained.3d
  ReservedFields.3d
  bf_constrained.gen
  reserved_fields.gen)
 (action
  (run
   ./main.exe
   .
   %{project_root}/examples/generated/clcw.ml:record:Clcw.WireCLCW:16
   bf_constrained.gen:record:BfConstrained.WireBfConstrained:16
   reserved_fields.gen:record:ReservedFields.WireReservedFields:16)))

; The packet-stack scanner, on OCaml and on OxCaml: every read of fold,
; frames_record and fold_frames in bounds, the fields fold_frames loads ahead
; of frames_record included, and no input raising.

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps %{project_root}/examples/generated/stack.ml Stack.3d stack_ox.gen)
 (action
  (run
   ./main.exe
   --bounds-only
   .
   %{project_root}/examples/generated/stack.ml:scanner/34:Stack.WireEthernetStack:128
   stack_ox.gen:scanner-ox/34:Stack.WireEthernetStack:128)))

; The scanner's answers against the specification, on every window of up to
; 128 bytes: one query per path, the longest of which take minutes, so they
; run on their own: BUILD_EVERPARSE=1 dune build @verify/equivalence.

(rule
 (alias equivalence)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps %{project_root}/examples/generated/stack.ml Stack.3d stack_ox.gen)
 (action
  (run
   ./main.exe
   --jobs
   8
   --timeout
   1800
   .
   %{project_root}/examples/generated/stack.ml:scanner/34:Stack.WireEthernetStack:128
   stack_ox.gen:scanner-ox/34:Stack.WireEthernetStack:128)))

; The checker finds defects planted in the generated scanner: the header
; check of fold_ipv4 removed (reads past the frame), the payload check off by
; one (rejects a frame whose payload ends the window, which the
; specification accepts), and fold_frames taking the
; walk without frame checks for strides too short for it, which hands
; frames_record a frame shorter than its precondition, the protocol loaded
; ahead for the third frame read from the second, which hands frames_record a
; protocol its frame does not hold, and the unrolled loop run while only three
; frames are left, whose loads ahead read past the window. On OxCaml, the same
; three defects of fold_frames.

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   no_header_check.mutant
   (run
    sed
    "s/if (stop : int) < 34 then invalid ()/if false then invalid ()/"
    %{dep:../examples/generated/stack.ml}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   payload_off_by_one.mutant
   (run
    sed
    "s/if (f9_ipv4_total_length : int) > stop - 14 then invalid ()/if (f9_ipv4_total_length : int) >= stop - 14 then invalid ()/"
    %{dep:../examples/generated/stack.ml}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   stride_threshold.mutant
   (run
    sed
    "s/if stride < 34 then/if stride < 30 then/"
    %{dep:../examples/generated/stack.ml}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   ahead_wrong_frame.mutant
   (run
    sed
    "s/Wire_runtime.Unchecked.u8 buf (base_2 + 23)/Wire_runtime.Unchecked.u8 buf (base_1 + 23)/"
    %{dep:../examples/generated/stack.ml}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   ahead_past_window.mutant
   (run
    sed
    "s/let last_4 = off + len - (4 \\* stride) in/let last_4 = off + len - (3 * stride) in/"
    %{dep:../examples/generated/stack.ml}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   stride_threshold_ox.mutant
   (run
    sed
    "s/if stride < 34 then (/if stride < 30 then (/"
    %{dep:stack_ox.gen}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   ahead_wrong_frame_ox.mutant
   (run
    sed
    "s/(L.u16le_at buf (U.add base_2 #22L))/(L.u16le_at buf (U.add base_1 #22L))/"
    %{dep:stack_ox.gen}))))

(rule
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (action
  (with-stdout-to
   ahead_past_window_ox.mutant
   (run
    sed
    "s/let last_4 = U.of_int (off + len - (4 \\* stride)) in/let last_4 = U.of_int (off + len - (3 * stride)) in/"
    %{dep:stack_ox.gen}))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps
  Stack.3d
  no_header_check.mutant
  payload_off_by_one.mutant
  stride_threshold.mutant
  ahead_wrong_frame.mutant
  ahead_past_window.mutant
  stride_threshold_ox.mutant
  ahead_wrong_frame_ox.mutant
  ahead_past_window_ox.mutant)
 (action
  (progn
   (run
    ./main.exe
    --bounds-only
    --only
    fold
    --expect-refuted
    "reads 8 bytes inside the buffer"
    .
    no_header_check.mutant:scanner/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --only
    fold
    --expect-refuted
    "answers as"
    .
    payload_off_by_one.mutant:scanner/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "frames_record meets its precondition"
    .
    stride_threshold.mutant:scanner/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "frames_record meets its precondition"
    .
    ahead_wrong_frame.mutant:scanner/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "inside the window"
    .
    ahead_past_window.mutant:scanner/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "frames_record meets its precondition"
    .
    stride_threshold_ox.mutant:scanner-ox/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "frames_record meets its precondition"
    .
    ahead_wrong_frame_ox.mutant:scanner-ox/34:Stack.WireEthernetStack:64)
   (run
    ./main.exe
    --bounds-only
    --only
    fold_frames
    --expect-refuted
    "inside the window"
    .
    ahead_past_window_ox.mutant:scanner-ox/34:Stack.WireEthernetStack:64))))

; Checks that no input needs: each check of a generated function is taken
; out in turn. The code without it must read in bounds and raise nothing, or
; the check is needed for safety, and must answer as the code with it on
; every input, or the check is needed for semantics; otherwise it is
; redundant. fold and frames_record answer accept or reject, which the
; equivalence lane proves equal to the specification; fold_frames with any
; arguments answers whether it raises Invalid_argument, for its argument
; checks (its other checks are those of fold and frames_record). Every check
; of the three on the OCaml scanner is classified, and the run fails if one
; is redundant or undecided, or if it finds none.

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps %{project_root}/examples/generated/stack.ml Stack.3d)
 (action
  (run
   ./main.exe
   --classify-checks
   --expect
   safety,semantics
   .
   %{project_root}/examples/generated/stack.ml:scanner/34:Stack.WireEthernetStack:128)))

; The same on the step scanner, and on OxCaml for fold and frames_record
; and their step forms, which take minutes more: BUILD_EVERPARSE=1 dune build
; @verify/classify. The argument checks of the OxCaml frame loops are not
; classified: walking their unrolled loop without stride <= 0 takes over an
; hour; they are the checks of the OCaml frame loop, written by the same
; code.

(rule
 (alias classify)
 (enabled_if
  (and
   (= %{env:BUILD_EVERPARSE=} "1")
   %{bin-available:z3}))
 (deps stack_ox.gen stack_step.gen stack_step_ox.gen Stack.3d)
 (action
  (progn
   (run
    ./main.exe
    --classify-checks
    --expect
    safety,semantics
    .
    stack_step.gen:step/34:Stack.WireEthernetStack:128)
   (run
    ./main.exe
    --classify-checks
    --only
    fold
    --expect
    safety,semantics
    .
    stack_ox.gen:scanner-ox/34:Stack.WireEthernetStack:128)
   (run
    ./main.exe
    --classify-checks
    --only
    frames_record
    --expect
    safety,semantics
    .
    stack_ox.gen:scanner-ox/34:Stack.WireEthernetStack:128)
   (run
    ./main.exe
    --classify-checks
    --only
    fold_step
    --expect
    safety,semantics
    .
    stack_step_ox.gen:step-ox/34:Stack.WireEthernetStack:128)
   (run
    ./main.exe
    --classify-checks
    --only
    frames_step_record
    --expect
    safety,semantics
    .
    stack_step_ox.gen:step-ox/34:Stack.WireEthernetStack:128))))
