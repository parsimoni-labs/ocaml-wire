;; ihl read with three bits instead of four: the proof must fail.

(rule
 (targets used.IPv4Mutant)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  used.lib
  (glob_files lib/*.fst)
  ../fstar/Plan.Word.fst
  ../fstar/Plan.Expr.fst
  ../fstar/Plan.Values.fst
  ../../scripts/fstar-gen/prove.exe
  (glob_files IPv4Mutant.*)
  (env_var WIRE_PROVE_TIMEOUT))
 (action
  (run sh prove.sh refused IPv4Mutant "s/(P.land bw1 0xf)/(P.land bw1 0x7)/")))

;; The step walk of the CLCW with vcid shifted out of its word one bit too
;; few: the step proof must fail.

(rule
 (targets used.ClcwStepMutant)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  used.lib
  (glob_files lib/*.fst)
  ../fstar/Plan.Word.fst
  ../fstar/Plan.Expr.fst
  ../fstar/Plan.Values.fst
  ../../scripts/fstar-gen/prove.exe
  (glob_files ClcwStepMutant.*)
  (env_var WIRE_PROVE_TIMEOUT))
 (action
  (run
   sh
   prove.sh
   refused
   ClcwStepMutant
   "s/(P.shift_right_logical bw1 18) 63/(P.shift_right_logical bw1 17) 63/"
   Step)))

;; The OxCaml fold of Tiny with [a] read from the low byte of the 16-bit
;; load one byte on, the byte after [a]: the OxCaml proof must fail.

(rule
 (targets used.TinyOxMutant)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  used.lib
  (glob_files lib/*.fst)
  ../fstar/Plan.Word.fst
  ../fstar/Plan.Expr.fst
  ../fstar/Plan.Values.fst
  ../../scripts/fstar-gen/prove.exe
  (glob_files TinyOxMutant.*)
  (env_var WIRE_PROVE_TIMEOUT))
 (action
  (run
   sh
   prove.sh
   refused
   TinyOxMutant
   "s/(P.u16le_at buf base)) 255)/(P.u16le_at buf (P.int64_add base 1))) 255)/"
   OxScan)))

;; Once every run has listed the cache entries it used, the rest of
;; WIRE_FSTAR_CACHE goes: other F* versions, the 3d.exe output of a .3d that
;; changed, modules no codec has any more.

(rule
 (alias prove)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  prove.sh
  ../../scripts/fstar-gen/prove.exe
  (env_var WIRE_FSTAR_CACHE))
 (action
  (run
   sh
   prove.sh
   prune
   %{dep:used.lib}
   %{dep:used.Tiny}
   %{dep:used.Ethernet}
   %{dep:used.IPv4}
   %{dep:used.Clcw}
   %{dep:used.Span}
   %{dep:used.Gate}
   %{dep:used.Dispatch}
   %{dep:used.Region}
   %{dep:used.IPv4Mutant}
   %{dep:used.ClcwStepMutant}
   %{dep:used.TinyOxMutant})))
