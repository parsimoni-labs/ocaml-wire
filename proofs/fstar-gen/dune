;; ihl read with three bits instead of four: the proof must fail.

(rule
 (targets used.IPv4Mutant)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  used.lib
  ../../scripts/fstar-gen/prove.exe
  (glob_files IPv4Mutant.*)
  (env_var WIRE_PROVE_TIMEOUT))
 (action
  (run sh prove.sh refused IPv4Mutant "s/(P.land bw1 0xf)/(P.land bw1 0x7)/")))

;; Once every run has listed the cache entries it used, the rest of
;; WIRE_FSTAR_CACHE goes: other F* versions, the 3d.exe output of a .3d that
;; changed, modules no codec has any more.

(rule
 (alias prove)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  prove.sh
  ../../scripts/fstar-gen/prove.exe
  (env_var WIRE_FSTAR_CACHE))
 (action
  (run
   sh
   prove.sh
   prune
   %{dep:used.lib}
   %{dep:used.Tiny}
   %{dep:used.Ethernet}
   %{dep:used.IPv4}
   %{dep:used.Clcw}
   %{dep:used.Span}
   %{dep:used.Gate}
   %{dep:used.Dispatch}
   %{dep:used.Region}
   %{dep:used.IPv4Mutant})))
