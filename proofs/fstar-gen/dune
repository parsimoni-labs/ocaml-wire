  used.lib
  (glob_files lib/*.fst)
  ../fstar/Plan.Word.fst
  ../fstar/Plan.Expr.fst
  ../fstar/Plan.Values.fst
  ../../scripts/fstar-gen/prove.exe
  (glob_files Tiny.*)
  (env_var WIRE_PROVE_TIMEOUT))
 (action
  (run sh prove.sh codec Tiny)))

