;; The primitives of WireGen.OCaml on the operands the OCaml runtime was
;; run on, which F* must agree with.

(rule
 (targets WireGen.Vectors.fst)
 (action
  (with-stdout-to
   WireGen.Vectors.fst
   (run %{exe:../../scripts/fstar-gen/vectors.exe}))))

;; The OxCaml primitives the F* rendering of the OxCaml scanner reads as
;; those of WireGen.OCaml, run on OxCaml: WireGen.VectorsOx.fst is committed,
;; make prove checks it with F*, and on an OxCaml compiler runtest checks it
;; is what OxCaml computes (dune promote writes it again).

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   VectorsOx.out
   (run %{exe:../../scripts/fstar-gen/vectors_ox.exe}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (diff WireGen.VectorsOx.fst VectorsOx.out)))

;; The rules that use the F* cache run in the build directory, where
;; prove.sh finds the default cache, never in a sandbox. A codec's rule
;; depends on the library's sources as well as on used.lib, which lists the
;; library's cache entries by name: a change to the library alone checks
;; each codec again.

(rule
 (targets used.lib)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
  (sandbox none)
  prove.sh
  ../../scripts/fstar-gen/prove.exe
  (glob_files lib/*.fst)
  (glob_files lib/*.fsti)
  ../fstar/Plan.Word.fst
  ../fstar/Plan.Expr.fst
  ../fstar/Plan.Values.fst
  WireGen.Vectors.fst
  WireGen.VectorsOx.fst
  (env_var EVERPARSE)
  (env_var WIRE_FSTAR_CACHE))
 (action
  (run
   sh
   prove.sh
   lib
   ../fstar/Plan.Word.fst
   ../fstar/Plan.Expr.fst
   ../fstar/Plan.Values.fst
   lib/WireGen.Lib.fst
   lib/WireGen.OCaml.fst
   lib/WireGen.Defs.fst
   lib/WireGen.Tables.fst
   lib/WireGen.Tac.fst
   lib/WireGen.Lib3d.fst
   WireGen.Vectors.fst
   WireGen.VectorsOx.fst)))

(rule
 (targets used.Tiny)
 (enabled_if
  (= %{env:BUILD_EVERPARSE=} "1"))
 (deps
