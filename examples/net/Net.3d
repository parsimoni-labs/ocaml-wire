   Opt_seamsub_total_length_lsl_ihl_2_StackUDP(((((((flags & 1) == 0) && (fragment_offset == 0)) && (protocol == 17))) ? 1 : 0),
   total_length,
   ihl) udp;
   UINT8 opaque_[:byte-size (((!(((((flags & 1) == 0) && (fragment_offset == 0)) && (protocol == 6)) || ((((flags & 1) == 0) && (fragment_offset == 0)) && (protocol == 17))))) ? (total_length - (ihl << 2)) : 0)];
} StackIPv4;

casetype _Opt_StackIPv4(UINT8 present) {
                                          switch (present) {
