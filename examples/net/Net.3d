entrypoint
typedef struct WireEthernetStack
{
   UINT8 dst[:byte-size 6];
   UINT8 src[:byte-size 6];
   UINT16BE ether_type;
   Opt_StackIPv4((((ether_type == 2048)) ? 1 : 0)) ipv4;
