; Differential fuzzer: each sampled codec of Diff_ocaml.codecs against the
; OCaml Wire_ocaml generates from it. Generating and compiling that code needs
; no EverParse, so it always builds and runs in the default [dune runtest]; the
; afl profile turns it into an AFL lane instead.

(library
 (name diff_ocaml)
 (modules diff_ocaml)
 (libraries wire wire.runtime fuzz_gen diff_codecs alcobar fmt))

; The generator (test/diff/gen_ocaml.ml) writes the module for each codec, and
; the scanners. test/ocaml runs the structured cases' corpora through them too.
; They are split by size over the shards, each compiled on its own, so that no
; compiler run holds all of them: as one module they took over 700 MB of heap.
; ocaml_index.ml lists them.

(library
 (name ocaml_index)
 (wrapped false)
 (modules
  ocaml_index
  ocaml_index_0
  ocaml_index_1
  ocaml_index_2
  ocaml_index_3
  ocaml_index_4
  ocaml_index_5
  ocaml_index_6
  ocaml_index_7
  ocaml_index_8
  ocaml_index_9
  ocaml_index_10
  ocaml_index_11
  ocaml_index_12
  ocaml_index_13
  ocaml_index_14
  ocaml_index_15)
 (libraries wire wire.runtime fuzz_gen diff_codecs diff_ocaml fmt))

(rule
 (targets
  ocaml_index.ml
  ocaml_index_0.ml
  ocaml_index_1.ml
  ocaml_index_2.ml
  ocaml_index_3.ml
  ocaml_index_4.ml
  ocaml_index_5.ml
  ocaml_index_6.ml
  ocaml_index_7.ml
  ocaml_index_8.ml
  ocaml_index_9.ml
  ocaml_index_10.ml
  ocaml_index_11.ml
  ocaml_index_12.ml
  ocaml_index_13.ml
  ocaml_index_14.ml
  ocaml_index_15.ml)
 (action
  (run %{dep:../../../test/diff/gen_ocaml.exe} %{targets})))

(executable
 (name fuzz)
 (modules fuzz)
 (libraries
  wire
  wire.runtime
  fuzz_gen
  diff_codecs
  diff_driver
  diff_ocaml
  ocaml_index
  alcobar
  fmt))

; The seed, repeat and budget knobs of fuzz/dune, with a budget of one second
; per codec by default.

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} afl))
 (action
  (run
   %{exe:fuzz.exe}
   -s
   %{env:WIRE_FUZZ_SEED=42}
   -r
   %{env:WIRE_FUZZ_REPEAT=5000}
   --budget
   %{env:WIRE_FUZZ_BUDGET=1})))

; afl-fuzz searches PATH for a target with no '/', so pass [./fuzz.exe] (the
; cwd is this dir in the build tree, where fuzz.exe is built).

(rule
 (alias fuzz)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe ../../afl.dict)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run
    afl-fuzz
    -V
    60
    -t
    8000
    -x
    ../../afl.dict
    -i
    corpus
    -o
    _fuzz
    --
    ./fuzz.exe
    @@))))
