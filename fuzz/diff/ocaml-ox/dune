; The OCaml backend again, on the code Wire_ocaml writes for OxCaml, whose
; [@zero_alloc] checks the compiler enforces. Only an OxCaml compiler builds
; the index, split as in fuzz/diff/ocaml. On any other, fuzz.exe is a stub that
; says the lane was skipped, and the AFL campaign does not repeat
; fuzz/diff/ocaml.

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (targets
  ocaml_index.ml
  ocaml_index_0.ml
  ocaml_index_1.ml
  ocaml_index_2.ml
  ocaml_index_3.ml
  ocaml_index_4.ml
  ocaml_index_5.ml
  ocaml_index_6.ml
  ocaml_index_7.ml
  ocaml_index_8.ml
  ocaml_index_9.ml
  ocaml_index_10.ml
  ocaml_index_11.ml
  ocaml_index_12.ml
  ocaml_index_13.ml
  ocaml_index_14.ml
  ocaml_index_15.ml)
 (action
  (run %{dep:../../../test/diff/gen_ocaml.exe} --oxcaml %{targets})))

(library
 (name ocaml_index_ox)
 (wrapped false)
 (enabled_if
  (= %{ocaml-config:ox} true))
 (modules
  ocaml_index
  ocaml_index_0
  ocaml_index_1
  ocaml_index_2
  ocaml_index_3
  ocaml_index_4
  ocaml_index_5
  ocaml_index_6
  ocaml_index_7
  ocaml_index_8
  ocaml_index_9
  ocaml_index_10
  ocaml_index_11
  ocaml_index_12
  ocaml_index_13
  ocaml_index_14
  ocaml_index_15)
 (libraries wire wire.runtime fuzz_gen diff_ocaml fmt))

; An executable's enabled_if cannot read %{ocaml-config:ox}, so fuzz.exe
; selects the fuzzer on whether the index library is enabled.

(rule
 (copy ../ocaml/fuzz.ml fuzz.ox.ml))

(rule
 (with-stdout-to
  fuzz.std.ml
  (echo
   "let () = Fmt.pr \"fuzz/diff/ocaml-ox: skipped, OCaml %s is not an OxCaml compiler@.\" Sys.ocaml_version\n")))

(executable
 (name fuzz)
 (modules fuzz)
 (libraries
  fmt
  fuzz_gen
  diff_codecs
  diff_driver
  diff_ocaml
  (select
   fuzz.ml
   from
   (ocaml_index_ox -> fuzz.ox.ml)
   (-> fuzz.std.ml))))

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} afl))
 (action
  (run
   %{exe:fuzz.exe}
   -s
   %{env:WIRE_FUZZ_SEED=42}
   -r
   %{env:WIRE_FUZZ_REPEAT=5000}
   --budget
   %{env:WIRE_FUZZ_BUDGET=1})))

(rule
 (alias fuzz)
 (enabled_if
  (and
   (= %{profile} afl)
   (= %{ocaml-config:ox} true)))
 (deps fuzz.exe ../../afl.dict)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run
    afl-fuzz
    -V
    60
    -t
    8000
    -x
    ../../afl.dict
    -i
    corpus
    -o
    _fuzz
    --
    ./fuzz.exe
    @@))))
