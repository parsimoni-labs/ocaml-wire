; The OCaml backend again, on the code Wire_ocaml writes for OxCaml, whose
; [@zero_alloc] checks the compiler enforces. On any other compiler the library
; holds the code for the default target instead, so the lane still builds, and
; neither [dune runtest] (which says the lane was skipped) nor the AFL campaign
; repeats fuzz/diff/ocaml.

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   ocaml_index.ml
   (run %{dep:../../../test/diff/gen_ocaml.exe} --oxcaml))))

(rule
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (action
  (with-stdout-to
   ocaml_index.ml
   (run %{dep:../../../test/diff/gen_ocaml.exe}))))

; Dune's dev profile compiles libraries -opaque, which hides from the
; zero_alloc checker what a function of another library allocates, so every
; call out of the module looks like it may. The checks run in any other
; profile (make test-oxcaml uses release) and are off in dev, where they
; cannot pass.

(rule
 (enabled_if
  (and
   (= %{ocaml-config:ox} true)
   (= %{profile} dev)))
 (action
  (with-stdout-to
   zero_alloc.sexp
   (echo "(-zero-alloc-check none)"))))

(rule
 (enabled_if
  (or
   (<> %{ocaml-config:ox} true)
   (<> %{profile} dev)))
 (action
  (with-stdout-to
   zero_alloc.sexp
   (echo "()"))))

(library
 (name ocaml_index_ox)
 (ocamlopt_flags
  (:standard
   (:include zero_alloc.sexp)))
 (wrapped false)
 (modules ocaml_index)
 (libraries wire wire.runtime fuzz_gen diff_ocaml fmt))

(rule
 (copy ../ocaml/fuzz.ml fuzz.ml))

(executable
 (name fuzz)
 (modules fuzz)
 (libraries fuzz_gen diff_codecs diff_driver diff_ocaml ocaml_index_ox))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{profile} afl)
   (= %{ocaml-config:ox} true)))
 (action
  (run
   %{exe:fuzz.exe}
   -s
   %{env:WIRE_FUZZ_SEED=42}
   -r
   %{env:WIRE_FUZZ_REPEAT=5000}
   --budget
   %{env:WIRE_FUZZ_BUDGET=1})))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{profile} afl)
   (<> %{ocaml-config:ox} true)))
 (action
  (echo
   "fuzz/diff/ocaml-ox: skipped, OCaml %{ocaml_version} is not an OxCaml compiler\n")))

(rule
 (alias fuzz)
 (enabled_if
  (and
   (= %{profile} afl)
   (= %{ocaml-config:ox} true)))
 (deps fuzz.exe ../../afl.dict)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run
    afl-fuzz
    -V
    60
    -t
    8000
    -x
    ../../afl.dict
    -i
    corpus
    -o
    _fuzz
    --
    ./fuzz.exe
    @@))))
