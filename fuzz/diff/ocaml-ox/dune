; The OCaml backend again, on the code Wire_ocaml writes for OxCaml, whose
; [@zero_alloc] checks the compiler enforces. On any other compiler the library
; holds the code for the default target instead, so the lane still builds, and
; neither [dune runtest] (which says the lane was skipped) nor the AFL campaign
; repeats fuzz/diff/ocaml. The index is split as in fuzz/diff/ocaml.

(rule
 (enabled_if
  (= %{ocaml-config:ox} true))
 (targets
  ocaml_index.ml
  ocaml_index_0.ml
  ocaml_index_1.ml
  ocaml_index_2.ml
  ocaml_index_3.ml
  ocaml_index_4.ml
  ocaml_index_5.ml
  ocaml_index_6.ml
  ocaml_index_7.ml
  ocaml_index_8.ml
  ocaml_index_9.ml
  ocaml_index_10.ml
  ocaml_index_11.ml
  ocaml_index_12.ml
  ocaml_index_13.ml
  ocaml_index_14.ml
  ocaml_index_15.ml)
 (action
  (run %{dep:../../../test/diff/gen_ocaml.exe} --oxcaml %{targets})))

(rule
 (enabled_if
  (<> %{ocaml-config:ox} true))
 (targets
  ocaml_index.ml
  ocaml_index_0.ml
  ocaml_index_1.ml
  ocaml_index_2.ml
  ocaml_index_3.ml
  ocaml_index_4.ml
  ocaml_index_5.ml
  ocaml_index_6.ml
  ocaml_index_7.ml
  ocaml_index_8.ml
  ocaml_index_9.ml
  ocaml_index_10.ml
  ocaml_index_11.ml
  ocaml_index_12.ml
  ocaml_index_13.ml
  ocaml_index_14.ml
  ocaml_index_15.ml)
 (action
  (run %{dep:../../../test/diff/gen_ocaml.exe} %{targets})))

(library
 (name ocaml_index_ox)
 (wrapped false)
 (modules
  ocaml_index
  ocaml_index_0
  ocaml_index_1
  ocaml_index_2
  ocaml_index_3
  ocaml_index_4
  ocaml_index_5
  ocaml_index_6
  ocaml_index_7
  ocaml_index_8
  ocaml_index_9
  ocaml_index_10
  ocaml_index_11
  ocaml_index_12
  ocaml_index_13
  ocaml_index_14
  ocaml_index_15)
 (libraries wire wire.runtime fuzz_gen diff_ocaml fmt))

(rule
 (copy ../ocaml/fuzz.ml fuzz.ml))

(executable
 (name fuzz)
 (modules fuzz)
 (libraries fuzz_gen diff_codecs diff_driver diff_ocaml ocaml_index_ox))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{profile} afl)
   (= %{ocaml-config:ox} true)))
 (action
  (run
   %{exe:fuzz.exe}
   -s
   %{env:WIRE_FUZZ_SEED=42}
   -r
   %{env:WIRE_FUZZ_REPEAT=5000}
   --budget
   %{env:WIRE_FUZZ_BUDGET=1})))

(rule
 (alias runtest)
 (enabled_if
  (and
   (<> %{profile} afl)
   (<> %{ocaml-config:ox} true)))
 (action
  (echo
   "fuzz/diff/ocaml-ox: skipped, OCaml %{ocaml_version} is not an OxCaml compiler\n")))

(rule
 (alias fuzz)
 (enabled_if
  (and
   (= %{profile} afl)
   (= %{ocaml-config:ox} true)))
 (deps fuzz.exe ../../afl.dict)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run
    afl-fuzz
    -V
    60
    -t
    8000
    -x
    ../../afl.dict
    -i
    corpus
    -o
    _fuzz
    --
    ./fuzz.exe
    @@))))
