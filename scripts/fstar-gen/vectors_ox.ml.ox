(* vectors_ox.exe prints WireGen.VectorsOx.fst: what each OxCaml primitive
   the F* rendering of the OxCaml scanner reads as a primitive of
   WireGen.OCaml returns, run on OxCaml on the operands of [Operands], an
   [int64_u] stated as its 64-bit pattern. F* checks each fact as
   WireGen.Vectors does. *)

open Operands
module U = Wire_runtime.Target.Int64_u
module B = Wire_runtime.Target
module L = Wire_runtime.Target.Local

let u w = U.of_int64 w
let pattern x = pattern64 (U.to_int64 x)

let pairs =
  List.concat_map (fun a -> List.map (fun b -> (a, b)) int64s) int64s
  |> List.filteri (fun i _ -> i mod 3 = 0)

(* [U.of_int], [U.of_int32_u], [U.to_int], [U.to_int64], [B.offset]. *)
let conversions ppf =
  List.iter
    (fun a ->
      norm ppf
        (Fmt.str "P.int64_of_int %s == %s" (lit a) (pattern (U.of_int a))))
    ints;
  List.iter
    (fun x ->
      norm ppf
        (Fmt.str "P.int64_of_int32 %s == %s" (pattern32 x)
           (pattern (U.of_int32_u (B.Int32_u.of_int32 x)))))
    int32s;
  List.iter
    (fun w ->
      norm ppf
        (Fmt.str "P.to_int %s == %s" (pattern64 w) (lit (U.to_int (u w))));
      norm ppf
        (Fmt.str "P.to_int64 %s == %s" (pattern64 w)
           (pattern64 (U.to_int64 (u w))));
      if Int64.compare w 0L >= 0 && Int64.compare w 0x3FFF_FFFF_FFFF_FFFFL <= 0
      then
        norm ppf
          (Fmt.str "P.offset %s == %s" (pattern64 w) (lit (B.offset (u w)))))
    int64s

(* The arithmetic, the signed comparisons and the unsigned one. *)
let arithmetic ppf =
  List.iter
    (fun (op, f) ->
      List.iter
        (fun (a, b) ->
          norm ppf
            (Fmt.str "P.int64_%s %s %s == %s" op (pattern64 a) (pattern64 b)
               (pattern (f (u a) (u b)))))
        pairs)
    [ ("add", U.add); ("sub", U.sub); ("mul", U.mul) ];
  List.iter
    (fun (op, f) ->
      List.iter
        (fun (a, b) ->
          norm ppf
            (Fmt.str "P.int64_%s %s %s == %b" op (pattern64 a) (pattern64 b)
               (f (U.compare (u a) (u b)) 0)))
        pairs)
    [
      ("lt", ( < ));
      ("le", ( <= ));
      ("gt", ( > ));
      ("ge", ( >= ));
      ("eq", ( = ));
      ("ne", ( <> ));
    ];
  List.iter
    (fun (a, b) ->
      norm ppf
        (Fmt.str "P.int64_unsigned_gt %s %s == %b" (pattern64 a) (pattern64 b)
           (B.unsigned_compare (u a) (u b) > 0)))
    pairs

(* The shifts, [U.logand] by the masks the emitter writes, and [U.logor]. *)
let bits ppf =
  List.iter
    (fun w ->
      List.iter
        (fun k ->
          norm ppf
            (Fmt.str "P.shift_right_logical %s %d == %s" (pattern64 w) k
               (pattern (U.shift_right_logical (u w) k)));
          norm ppf
            (Fmt.str "P.shift_left %s %d == %s" (pattern64 w) k
               (pattern (U.shift_left (u w) k))))
        [ 0; 1; 8; 16; 32; 48; 56; 63 ];
      List.iter
        (fun k ->
          let m = Int64.pred (Int64.shift_left 1L k) in
          Fmt.pf ppf
            "let _ = assert_norm (pow2 %d == %s); P.int64_mask %s %d; assert \
             (P.int64_logand %s %s == %s)@\n"
            k
            (pattern64 (Int64.shift_left 1L k))
            (pattern64 w) k (pattern64 w) (pattern64 m)
            (pattern (U.logand (u w) (u m))))
        [ 1; 8; 16; 32; 62 ])
    int64s;
  (* What the F* reads of [U.logor]: its sign, which its type states. *)
  List.iter
    (fun (a, b) ->
      Fmt.pf ppf
        "let _ = assert ((P.int64_logor %s %s >= 9223372036854775808) == %b)@\n"
        (pattern64 a) (pattern64 b)
        (U.compare (U.logor (u a) (u b)) (U.of_int 0) < 0))
    pairs

(* The loads at an [int64_u] position, and the byte at an [int] one. *)
let loads ppf =
  List.iteri
    (fun i b ->
      Fmt.pf ppf "let b%d : P.buf = %s@\n" i (seq b);
      List.iter
        (fun o ->
          let at = U.of_int o in
          Fmt.pf ppf "let _ = assert (P.u8 b%d %d == %d)@\n" i o (L.u8 b o);
          if o + 2 <= 16 then begin
            Fmt.pf ppf "let _ = assert (P.u16le_at b%d %d == %d)@\n" i o
              (L.u16le_at b at);
            Fmt.pf ppf "let _ = assert (P.u16be_at b%d %d == %d)@\n" i o
              (L.u16be_at b at)
          end;
          if o + 4 <= 16 then begin
            let p x = pattern32 (B.Int32_u.to_int32 x) in
            Fmt.pf ppf "let _ = assert (P.i32be_at b%d %d == %s)@\n" i o
              (p (L.i32be_at b at));
            Fmt.pf ppf "let _ = assert (P.i32le_at b%d %d == %s)@\n" i o
              (p (L.i32le_at b at))
          end;
          if o + 8 <= 16 then
            Fmt.pf ppf "let _ = assert (P.i64be_at b%d %d == %s)@\n" i o
              (pattern (L.i64be_at b at)))
        [ 0; 3; 8; 15 ])
    buffers

let () =
  let ppf = Format.std_formatter in
  Fmt.pf ppf
    "module WireGen.VectorsOx@\n\
     @\n\
     (* Generated by vectors_ox.exe on OxCaml: the OxCaml primitives on \
     boundary and random operands. Do not edit: promote it again from an \
     OxCaml switch. *)@\n\
     @\n\
     module P = WireGen.OCaml@\n\
     open WireGen.Defs@\n\
     @\n\
     #push-options \"--fuel 0 --ifuel 0 --z3rlimit 20\"@\n";
  conversions ppf;
  arithmetic ppf;
  bits ppf;
  Fmt.pf ppf
    "#pop-options@\n@\n#push-options \"--fuel 9 --ifuel 1 --z3rlimit 20\"@\n";
  loads ppf;
  Fmt.pf ppf "#pop-options@\n%!"
